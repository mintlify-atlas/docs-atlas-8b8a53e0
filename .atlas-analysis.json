  "keyFeatures": [
    "Google OAuth authentication with YouTube API integration",
    "YouTube video search with embeddable results",
    "Personal video collection management",
    "Direct video upload to YouTube",
    "Video privacy control (public, private, unlisted)",
    "User-specific video tracking and favorites"
  ],
  "publicApiSurface": [
    "VideoGuardado model - Saved/favorited videos",
    "VideoSubido model - Uploaded videos with privacy states",
    "login_view - User authentication",
    "google_login - OAuth flow initiation",
    "google_callback - OAuth callback handler",
    "buscar_video - YouTube video search",
    "guardar_video - Save video to collection",
    "mi_lista - View saved videos",
    "eliminar_video - Remove from collection",
    "subir_video_youtube - Upload video to YouTube",
    "mis_subidos - View uploaded videos",
    "cambiar_estado_video - Update video privacy",
    "borrar_video_subido - Delete uploaded video"
  ]
